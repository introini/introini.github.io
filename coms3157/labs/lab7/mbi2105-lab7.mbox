From a2bdd33fa5f4496f92c5cc037c162dbab1132cfb Mon Sep 17 00:00:00 2001
From: "michael.introini@gmail.com" <michael.introini@gmail.com>
Date: Sat, 8 Apr 2017 19:39:31 -0400
Subject: [PATCH 03/23] modified HandleTCPRequest.c to take client IP instead
 of database. Also handles calls to methods other than GET properly

---
 part2/HandleHTTPRequest.c | 61 +++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 61 insertions(+)
 create mode 100644 part2/HandleHTTPRequest.c

diff --git a/part2/HandleHTTPRequest.c b/part2/HandleHTTPRequest.c
new file mode 100644
index 0000000..4130e0e
--- /dev/null
+++ b/part2/HandleHTTPRequest.c
@@ -0,0 +1,61 @@
+#include <stdio.h>      /* for printf() and fprintf() */
+#include <sys/socket.h> /* for recv() and send() */
+#include <unistd.h>     /* for close() */
+#include <string.h>
+
+#define RESPBUFSIZE 4096   /* Size of receive buffer */
+
+void DieWithError(char *errorMessage);  /* Error handling function */
+
+char *validateMethod(int clntSocket, char *m) {
+    
+    char resp_buf[RESPBUFSIZE];
+    int len = 0;
+    int res = 0;
+    
+    if (strcmp("GET",m) != 0) { 
+  
+       len = sprintf(resp_buf, "%s","501 Not Implemented\r\n");
+       if ((res = send(clntSocket, resp_buf, len, 0)) != len)
+           DieWithError("sen() failed");
+        
+       len = sprintf(resp_buf,"%s","\r\n");
+       if ((res = send(clntSocket, resp_buf, len, 0)) != len)
+           DieWithError("sen() failed");
+       
+       len = sprintf(resp_buf, "%s","<html>\n<body>\n<h1>\n501 Not Implemented\n</h1>\n</body>\n</html>\r\n");
+       if ((res = send(clntSocket, resp_buf, len, 0)) != len)
+           DieWithError("sen() failed");
+
+       close(clntSocket);
+       return "501 Not Implemented";
+    }
+
+    return "200 OK";
+
+}
+
+void HandleHTTPRequest(char *clientIP, int clntSocket)
+{
+     int recvMsgSize;    /* Size of received message */
+    char requestLine[RESPBUFSIZE];        /* Buffer for echo string */
+    char *token_separators = "\t \r\n"; // tab, space, new line
+
+
+
+    /* Receive message from client */
+    if ((recvMsgSize = recv(clntSocket, requestLine, RESPBUFSIZE, 0)) < 0)
+        DieWithError("recv() failed");
+
+    
+    char *method = strtok(requestLine, token_separators);
+    char *requestURI = strtok(NULL, token_separators);
+    char *httpVersion = strtok(NULL, token_separators);
+    char *status = validateMethod(clntSocket, method);
+    
+
+    fprintf(stdout, "%s \"%s %s %s\" %s", clientIP, method, requestURI, httpVersion, status);
+
+
+    close(clntSocket);    /* Close client socket */
+}
-- 
