+#include "mylist.h"
+#include <stdlib.h>
+#include <stdio.h>
+
+struct Node *nalloc(void) {
+    return (struct Node *) malloc(sizeof(struct Node));
+};
+
+struct Node *addFront(struct List *list, void *data) {
+    struct Node *n;
+
+    n = nalloc();
+    n->data = data;
+
+    n->next = list->head;
+    list->head = n;
+
+    return n;
+}
+
+void traverseList(struct List *list, void (*f)(void *)) {
+    /*
+     * We'll need to create a pointer of type struct Node
+     * in order to keep track of where we are in the list.
+     * Then, we can assign the head to that pointer so we
+     * can determine when it's time to exti the loop. In our
+     * case, we want to print the list from first to last.
+     *
+     * The while loop will exit once 'head = null'
+     */
+    struct Node *node;
+    node = list->head; /* First node */
+
+    while(node) {
+        f(node->data); /* Passing the data to the function pointer */
+        node = node->next; /* setting node to next node in the list */
+    }
+}
