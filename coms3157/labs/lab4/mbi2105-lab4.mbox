 README.txt         |  4 ++++
 part1/mdb-lookup.c | 70 ++++++++++++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 74 insertions(+)
 create mode 100644 part1/mdb-lookup.c

diff --git a/README.txt b/README.txt
index 66dfd3e..8ba6845 100644
--- a/README.txt
+++ b/README.txt
@@ -9,3 +9,7 @@ The description should indicate whether your solution for the part is
 working or not.  You may also want to include anything else you would
 like to communicate to the grader such as extra functionalities you
 implemented or how you tried to fix your non-working code.
+
+PART1:
+95: {contigo} said {the mug of choice}
+
diff --git a/part1/mdb-lookup.c b/part1/mdb-lookup.c
new file mode 100644
index 0000000..ff94bad
--- /dev/null
+++ b/part1/mdb-lookup.c
@@ -0,0 +1,70 @@
+#include <stdlib.h>
+#include <assert.h>
+#include <string.h>
+#include "mdb.h"
+static void printRecs(void *p){
+    static int n = 1;
+    struct MdbRec *pRec = p;
+    fprintf(stdout,"   %d: {%s} said {%s}\n", n++, pRec->name, pRec->msg);
+}
+struct MdbRec *mdballoc(void) {
+        return (struct MdbRec *) malloc(sizeof(struct MdbRec)) ;    
+}
+void freeNodes(void *p){
+    free(p);
+}
+int main(int argc, char **argv) {
+
+    FILE *fp;
+    char *program = argv[0];
+    char *database = argv[1];
+
+    struct List list;
+    struct Node *node;
+    struct MdbRec *ptrRec;
+   
+    const char *s = "r";
+
+    if(argc != 2) {
+        fprintf(stderr, "usage: %s <database_file>\n", program);
+        exit(1);
+    } 
+    
+    if ((fp = fopen(database, s)) == NULL) {
+        fprintf(stderr, "Can't open %s\n", database);
+        exit(1);
+    }
+    
+    initList(&list);
+    node = NULL;      
+    
+    while(feof(fp) == 0){
+        ptrRec = mdballoc(); 
+    
+        if (fread(ptrRec,40,1,fp) == 1 ) {
+            node = addAfter(&list,node,(void *)ptrRec); 
+            if (node == NULL) {
+                perror("error");
+                exit(1);
+            }
+        } 
+        
+    }
+     
+    traverseList(&list,&printRecs);
+
+    if (ferror(fp)) {
+        perror("error");
+        exit(1);
+    }         
+
+    fclose(fp);
+
+
+
+    traverseList(&list,&freeNodes);
+    free(ptrRec);
+    removeAllNodes(&list);
+
+    return 0;
+}
-- 
