+#include <stdlib.h>
+#include <assert.h>
+#include <string.h>
+#include "mdb.h"
+static void printRecs(void *p){
+    static int n = 1;
+    struct MdbRec *pRec = p;
+    fprintf(stdout,"   %d: {%s} said {%s}\n", n++, pRec->name, pRec->msg);
+}
+int main(int argc, char **argv) {
+
+    FILE *fp;
+    char *program = argv[0];
+    char *database = argv[1];
+
+    struct List list;
+    struct Node *node;;
+    struct MdbRec rec, *pRec;
+   
+    const size_t NAMEBUFF = 16;
+    const size_t MSGBUFF = 24;
+    const char *s = "r";
+
+    if(argc != 2) {
+        fprintf(stderr, "usage: %s <database_file>\n", program);
+        exit(1);
+    } 
+    
+    if ((fp = fopen(database, s)) == NULL) {
+        fprintf(stderr, "Can't open %s\n", database);
+        exit(1);
+    } else {
+        initList(&list);
+
+        node = NULL;      
+    
+        while(!feof(fp)) {
+            
+            pRec = &rec;
+            if(fread(&rec,1,40,fp) != 0)  { 
+                node = addAfter(&list,node,(void *)&rec); 
+                if (node == NULL) {
+                    perror("error");
+                    exit(1);
+                }
+          
+            //fprintf(stdout,"   : {%s} said {%s}\n", pRec->name, pRec->msg);
+              
+            }
+
+        }
+
+
+     }   
+
+    //traverseList(&list,&printRecs);
+
+    if (ferror(fp)) {
+        perror("error");
+        exit(1);
+    }         
+
+    fclose(fp);
+
+    return 0;
