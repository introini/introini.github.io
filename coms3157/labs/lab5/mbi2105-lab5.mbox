+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+int main() {
+
+    unsigned int port; 
+    while ( port != 3 ) {
+        printf("port number: ");
+        fscanf(stdin, "%u", &port);
+
+        pid_t pid = fork();
+
+
+        if ( pid < 0 ) {
+        
+            perror("fork failed");
+            exit(1);
+        
+        } else if ( pid == 0 ) {
+            
+            //child process
+            fprintf(stderr, "[pid=%d]", (int)getpid());
+            fprintf(stderr, "mdb started on %u\n", port);
+
+            //execl("/bin/ps", "ps", "fj", (char *)0);
+            
+            execl("./mdb-lookup-server-nc2.sh", "mdb-lookup-server-nc2.sh", port, (char *)0);
+            
+            perror("execl failed");
+            exit(1);
+        
+        } else {
+
+            if ( waitpid(pid, NULL, 0) != pid ) {
+
+                perror("waitpid failed");
+                exit(1);
+
+            }
+
+            fprintf(stderr, "[pid=%d]", (int)pid);
+            fprintf(stderr, "mdb-lookup-server terminated\n");
+        
+        }
+
+    }
+    
+    return 0;
+}
-- 
