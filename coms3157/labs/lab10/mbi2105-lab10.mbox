--- /dev/null
+++ b/part1/strlist.cpp
@@ -0,0 +1,105 @@
+/* StrList Implementation */
+#include <cstring>
+#include "mystring.h"
+#include "strlist.h"
+
+extern "C" {
+#include "mylist.h"
+}
+
+// Default Constructor
+StrList::StrList()
+{
+    ::initList(&list);
+}
+
+// Destructor
+StrList::~StrList()
+{
+    ::removeAllNodes(&list);
+}
+
+// Copy Constructor
+StrList::StrList(const StrList& l) 
+{
+    // We initialize a new list
+    ::initList(&list);
+
+    // Creating a node pointer will
+    // allow us to walk the list and 
+    // add each element to the back of
+    // our copy constructed list.
+    struct Node *n = l.list.head;
+    while (n) {
+       MyString *t = (MyString *)n->data;
+       ::addBack(&list,t);
+       n = n->next;
+    }
+}
+
+// Copy Assignment
+StrList& StrList::operator=(const StrList& l)
+{
+    if (this == &l)
+        return *this;
+    
+    ::initList(&list);
+
+    struct Node *n = l.list.head; 
+
+    while (n) {
+       MyString *t = (MyString*)n->data;
+       ::addBack(&list,t);
+       n = n->next;
+    }
+
+    return *this;
+}
+
+// Walk the list and return its size
+int StrList::size() const
+{
+    int count = 0;
+    struct Node *n = list.head;
+    while(n) {
+        count++;
+        n = n->next;
+    }
+    return count;
+}
+
+void StrList::addFront(const MyString& s) 
+{   
+    MyString *t = &(MyString&)s;
+    ::addFront(&list,t);
+}
+
+StrList& StrList::operator+=(const StrList& l)
+{
+    if (this == &l)
+        perror("Functionality not yet implemented");
+    
+    struct Node *n = l.list.head;
+    while (n) {
+        MyString *t = (MyString*)n->data;
+        ::addBack(&list,t);
+        n = n->next;
+    }
+    return *this;
+
+}
+        
+ostream& operator<<(ostream& os, const StrList& l) 
+{
+    struct Node *n = l.list.head;
+
+    os << "{ ";
+    while (n) {
+        MyString *t = (MyString*)n->data;
+        os << " " << t << " ";
+        n = n->next;
+    }
+    os << " }" << endl;
+
+    return os;
+}
-- 
